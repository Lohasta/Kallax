<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="controller.DEAddUserController" 
            maxHeight="-Infinity" maxWidth="-Infinity" 
            minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="600.0" prefWidth="1000.0" 
            style="-fx-background-color: #EBF3F5;" 
            xmlns="http://javafx.com/javafx/26" 
            xmlns:fx="http://javafx.com/fxml/1">
   
   <left>
      <VBox prefWidth="220.0" style="-fx-background-color: #F6EDF0; -fx-border-color: #707070; -fx-border-width: 0 2 0 0;" BorderPane.alignment="CENTER">
         <children>
            
            <VBox alignment="CENTER" prefHeight="150.0" spacing="5.0">
               <children>
                  <Label text="SCODOC" textFill="#1a1a1a">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
                  <Label text="V10.0" textFill="#1a1a1a">
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
                  <VBox alignment="CENTER" spacing="2.0">
                     <children>
                        <Label text="Connecté en tant que :" textFill="#555555">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                        <Label fx:id="utilisateur" text="Enseignant" textFill="#E03A3E">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </VBox>
               </children>
            </VBox>
            
            <VBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="notesEns1" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-border-color: #707070; -fx-border-width: 0 0 1 0; -fx-cursor: hand;" text="Notes">
                     <font> <Font size="18.0" /> </font>
                     <padding> <Insets left="30.0" /> </padding>
                  </Button>
                  <Button fx:id="assiduiteEns1" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-border-color: #707070; -fx-border-width: 0 0 1 0; -fx-cursor: hand;" text="Assiduité">
                     <font> <Font size="18.0" /> </font>
                     <padding> <Insets left="30.0" /> </padding>
                  </Button>
                  <Button fx:id="gestionEns1" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-border-color: #707070; -fx-border-width: 0 0 1 0; -fx-cursor: hand;" text="Gestion">
                     <font> <Font size="18.0" /> </font>
                     <padding> <Insets left="30.0" /> </padding>
                  </Button>
                  <Button fx:id="paramEns1" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-border-color: #707070; -fx-border-width: 0 0 1 0; -fx-cursor: hand;" text="Paramètres">
                     <font> <Font size="18.0" /> </font>
                     <padding> <Insets left="30.0" /> </padding>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </VBox>
            
            <VBox alignment="BOTTOM_LEFT" prefHeight="80.0">
               <children>
                  <Button fx:id="deconnexion" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="50.0" prefWidth="220.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text=" Déconnexion">
                     <font> <Font size="18.0" /> </font>
                     <padding> <Insets left="20.0" /> </padding>
                  </Button>
               </children>
            </VBox>
            
         </children>
      </VBox>
   </left>
   
   <center>
      <VBox spacing="15.0" BorderPane.alignment="TOP_LEFT">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <Button fx:id="retour" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-cursor: hand;" text="&lt;- Retour">
               <font>
                  <Font size="18.0" />
               </font>
            </Button>
            
            <VBox alignment="CENTER" spacing="25.0" VBox.vgrow="ALWAYS">
               <children>
                  
                  <Label text="Ajouter un Utilisateur" textFill="#1a1a1a">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  
                    <GridPane alignment="CENTER" hgap="15.0" vgap="15.0" style="-fx-background-color: #FFFFFF; -fx-padding: 30; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" maxWidth="450.0">
                        <children>
                        
                            <Label text="Nom :" textFill="#1a1a1a" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <font>
                                <Font size="16.0" />
                            </font>
                            </Label>
                            <TextField fx:id="nameNewUser" prefHeight="35.0" prefWidth="200.0" promptText="Ex: Laurell" style="-fx-background-radius: 5; -fx-border-color: #707070; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <font>
                                <Font size="14.0" />
                            </font>
                            </TextField>
                            
                            <Label text="Prénom :" textFill="#1a1a1a" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <font>
                                <Font size="16.0" />
                            </font>
                            </Label>
                            <TextField fx:id="surnameNewUser" prefHeight="35.0" prefWidth="200.0" promptText="Ex: Johan" style="-fx-background-radius: 5; -fx-border-color: #707070; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <font>
                                <Font size="14.0" />
                            </font>
                            </TextField>

                            <Label text="E-Mail :" textFill="#1a1a1a" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <font>
                                <Font size="16.0" />
                            </font>
                            </Label>
                            <TextField fx:id="emailNewUser" prefHeight="35.0" prefWidth="200.0" promptText="Ex: johan@ikea.fr" style="-fx-background-radius: 5; -fx-border-color: #707070; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <font>
                                <Font size="14.0" />
                            </font>
                            </TextField>

                            <Label text="Mot de Passe :" textFill="#1a1a1a" GridPane.columnIndex="0" GridPane.rowIndex="3">
                            <font>
                                <Font size="16.0" />
                            </font>
                            </Label>
                            <TextField fx:id="passwdNewUser" prefHeight="35.0" prefWidth="200.0" style="-fx-background-radius: 5; -fx-border-color: #707070; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <font>
                                <Font size="14.0" />
                            </font>
                            </TextField>
                            
                            <HBox alignment="CENTER_RIGHT" spacing="15.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <GridPane.margin>
                                <Insets top="15.0" />
                            </GridPane.margin>
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: #707070; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Annuler">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#handleAdd" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: #b63d31; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;" text="Ajouter">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                           </children>
                        </HBox>
                        
                    </children>
                  </GridPane>
                  
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>