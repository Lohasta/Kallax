<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
   <children>
      
      <ImageView pickOnBounds="true" preserveRatio="false" StackPane.alignment="CENTER">
         <image>
            <Image url="@../../assets/iut_blurred.png" />
         </image>
         <fitWidth><StackPane fx:constant="USE_COMPUTED_SIZE" /></fitWidth>
         <fitHeight><StackPane fx:constant="USE_COMPUTED_SIZE" /></fitHeight>
      </ImageView>

      <VBox alignment="CENTER" maxHeight="750.0" maxWidth="540.0" spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.25); -fx-background-radius: 5px; -fx-padding: 20px;">
         <children>
            
            <ImageView fitHeight="500.0" fitWidth="500.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../assets/logoKallax.png" />
               </image>
            </ImageView>
            
            <TextField fx:id="usernameField" prefHeight="45.0" promptText="Login" style="-fx-background-color: #F6EFF2; -fx-background-radius: 0px; -fx-prompt-text-fill: #000000; -fx-text-fill: #000000;">
               <font>
                  <Font name="Arial" size="16.0" />
               </font>
            </TextField>
            
            <PasswordField fx:id="passwordField" prefHeight="45.0" promptText="Mot de Passe" style="-fx-background-color: #F6EFF2; -fx-background-radius: 0px; -fx-text-fill: #000000;">
               <font>
                  <Font name="Arial" size="16.0" />
               </font>
            </PasswordField>
            
            <Button fx:id="loginButton" mnemonicParsing="false" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #E6F2F2; -fx-background-radius: 20px; -fx-text-fill: #000000; -fx-cursor: hand;" text="Se connecter">
               <font>
                  <Font name="Arial" size="15.0" />
               </font>
            </Button>
            
         </children>
         <StackPane.margin>
            <Insets left="80.0" />
         </StackPane.margin>
      </VBox>

   </children>
</StackPane>
